# คัดลอกเป็น .env.local แล้วเติมค่าจริง
# อย่า commit .env.local

# Supabase — หาได้ที่ Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ใช้เฉพาะฝั่งเซิร์ฟเวอร์ ตอนผู้ใช้ลบบัญชีตัวเอง
SUPABASE_SECRET_KEY=

# AI — groq หรือ gemini
TALEVO_AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# ไม่ใส่ก็ได้ ระบบจะใช้โมเดลเริ่มต้นของผู้ให้บริการที่เลือก
TALEVO_AI_MODEL=

# Web Push — สร้างคู่กุญแจด้วย: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# ความลับที่ใช้ยืนยันว่าคำขอส่งแจ้งเตือนมาจากตัวตั้งเวลาจริง
PUSH_DISPATCH_SECRET=
